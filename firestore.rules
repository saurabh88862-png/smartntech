rules_version = '2';

// SmartNTech — Firestore security rules
// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Only the admin account can edit content or read stats/messages.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rlakshminarayan66@gmail.com';
    }

    // Site text + articles: everyone can read, only admin can change.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visitor counters: anyone may add exactly +1, only admin can read.
    match /stats/{doc} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.count == 1
                    && request.resource.data.keys().hasOnly(['count', 'date']);
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.keys().hasOnly(['count', 'date']);
    }

    // "Online now" heartbeats: a visitor can only write a server timestamp.
    match /presence/{visitorId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen'])
                            && request.resource.data.lastSeen == request.time;
    }

    // Contact form: anyone can send, only admin can read or delete.
    match /messages/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.subject is string && request.resource.data.subject.size() <= 60
                    && request.resource.data.message is string && request.resource.data.message.size() <= 4000
                    && request.resource.data.createdAt == request.time;
    }
  }
}
